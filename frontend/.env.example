# ============================================================================
# WebStackPro Frontend Environment
# Copy to .env.local and fill in your real values. Never commit secrets.
# For Vercel production, set these in: Project > Settings > Environment Variables
# ============================================================================

# Backend WebStackPro API (Express + Socket.io)
# Local:  http://localhost:4000
# Prod:   your Render URL, e.g. https://webstackpro-api.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Supabase project (WebStackPro uses Supabase Auth: Email + Google)
NEXT_PUBLIC_SUPABASE_URL="https://YOURPROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"