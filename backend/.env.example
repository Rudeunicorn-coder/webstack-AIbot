# ============================================================================
# WebStackPro Backend Environment
# Copy to .env and fill in your real values. Never commit .env to git.
# ============================================================================

# --- WebStackPro Database (Supabase Postgres) ---
# Get this from Supabase > Project Settings > Database > Connection string
# Recommended: use the transaction/pooler URL to support pgvector + migrations
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOURPROJECT.supabase.co:5432/postgres?pgbouncer=true"

# pgvector RAG embeddings live in the same Supabase Postgres database.
# Ensure the extension is enabled via:  CREATE EXTENSION IF NOT EXISTS vector;
VECTOR_DIM=1536

# --- WebStackPro Auth ---
# Supabase project URL + anon key (Supabase > Settings > API)
SUPABASE_URL="https://YOURPROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# JWT secret used by Express to sign/verify API session tokens
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- WebStackPro AI ---
# Provider: "openai" (default, paid) or "groq" (free tier, no card needed).
# Groq is OpenAI-compatible; get a free key at https://console.groq.com
AI_PROVIDER="groq"
GROQ_API_KEY="gsk_YOUR_GROQ_KEY"
OPENAI_API_KEY="sk-YOUR_OPENAI_KEY"
# Model overrides (optional):
# AI_MODEL="llama-3.3-70b-versatile"       (Groq default)
# OPENAI_MODEL="gpt-4o-mini"               (OpenAI default)
# EMBED_MODEL="text-embedding-3-small"     (OpenAI embeddings; Groq skips embeddings)
AI_CONFIDENCE_THRESHOLD=0.8

# --- WebStackPro Queue (Redis) ---
REDIS_URL="redis://default:YOURPASSWORD@localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- WebStackPro Payments (Paystack) ---
PAYSTACK_SECRET_KEY="sk_test_YOUR_PAYSTACK_SECRET"
PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PAYSTACK_PUBLIC"
# Webhook secret — send as header x-webstackpro-signature to validate events
WEBHOOK_SECRET="webstackpro-webhook-secret-change-me"

# WebStackPro plan pricing in Naira (kobo units for Paystack: naira * 100)
PLAN_STARTER_PRICE_NAIRA=50000
PLAN_PRO_PRICE_NAIRA=120000
TRIAL_DAYS=14

# --- WebStackPro Frontend ---
FRONTEND_URL="http://localhost:3000"
PORT=4000

# Public URL of THIS API, used to build the webhook URLs shown in Settings
# (paste these into Meta). Set this to your deployed API, e.g. a Railway URL.
# When unset we fall back to RAILWAY_PUBLIC_DOMAIN, then FRONTEND_URL, then localhost.
# API_PUBLIC_URL="https://your-api.up.railway.app"

# --- WebStackPro Channel credentials (optional; fill when connecting) ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="webstackpro_verify"
INSTAGRAM_ACCESS_TOKEN=""
MESSENGER_ACCESS_TOKEN=""
MESSENGER_PAGE_ID=""