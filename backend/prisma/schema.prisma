// WebStackPro Prisma Schema
// Database: Supabase Postgres (with pgvector extension for RAG embeddings)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
// WebStackPro BUSINESS
// =============================

// A WebStackPro customer (Nigerian business using the Agent + Unified Inbox)
model WebStackProBusiness {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  plan      String   @default("trial") // trial | starter | pro
  trialEnds DateTime?
  planActive Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations WebStackProConversation[]
  knowledge     WebStackProKnowledge[]
  agents        WebStackProAgent[]
  channels      WebStackProChannel[]
  contacts      WebStackProContact[]
  subscriptions WebStackProSubscription[]
  notes         WebStackProNote[]
  tags          WebStackProTag[]
  canned        WebStackProCannedReply[]

  @@index([ownerId])
}

// =============================
// WebStackPro CONVERSATION
// =============================
model WebStackProConversation {
  id         String   @id @default(cuid())
  businessId String
  contactId  String?
  channel    String // whatsapp | instagram | messenger | web
  status     String   @default("ai") // ai | human
  assignedTo String? // WebStackPro Agent email or name
  threadKey  String? @unique // external thread identifier from the channel
  unread     Boolean  @default(true)
  lastMessageAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business WebStackProBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  WebStackProContact?     @relation(fields: [contactId], references: [id])
  messages WebStackProMessage[]
  notes    WebStackProNote[]

  @@index([businessId, status])
  @@index([businessId, channel])
}

// =============================
// WebStackPro MESSAGE
// =============================
model WebStackProMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | ai | human
  text           String
  channel        String // whatsapp | instagram | messenger | web
  meta           Json?
  createdAt      DateTime @default(now())

  conversation WebStackProConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// =============================
// WebStackPro CONTACT
// =============================
model WebStackProContact {
  id         String   @id @default(cuid())
  businessId String
  name       String
  channel    String
  externalId String? // id from the channel platform
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      WebStackProBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations WebStackProConversation[]
  tags          WebStackProTag[]          @relation("ContactTags")

  @@unique([businessId, externalId])
  @@index([businessId])
}

// =============================
// WebStackPro KNOWLEDGE (RAG source)
// =============================
model WebStackProKnowledge {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  // pgvector embedding: Unsupported("vector(1536)")? -> stored via raw SQL query.
  // Supabase pgvector is queried through the raw SQL helper in lib/pgvector.js
  embedding  Unsupported("vector(1536)")?
  source     String   @default("manual") // manual | upload | pdf | txt
  createdAt  DateTime @default(now())

  business WebStackProBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// =============================
// WebStackPro AGENT (human team member)
// =============================
model WebStackProAgent {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String
  role       String   @default("agent") // admin | agent
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business WebStackProBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
}

// =============================
// WebStackPro CHANNEL CONNECTIONS
// =============================
model WebStackProChannel {
  id         String   @id @default(cuid())
  businessId String
  type       String // whatsapp | instagram | messenger | web
  label      String
  config     Json?
  connected  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business WebStackProBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
  @@index([businessId])
}

// =============================
// WebStackPro SUBSCRIPTIONS (Paystack)
// =============================
model WebStackProSubscription {
  id            String   @id @default(cuid())
  businessId    String
  plan          String
  reference     String   @unique
  paystackSubId String?  @unique
  status        String   @default("pending") // pending | active | cancelled
  email         String
  amount        Int
  createdAt     DateTime @default(now())

  business WebStackProBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// =============================
// WebStackPro NOTES & TAGS
// =============================
model WebStackProNote {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String?
  contactId      String?
  body           String
  author         String
  createdAt      DateTime @default(now())

  business      WebStackProBusiness      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation  WebStackProConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model WebStackProTag {
  id         String   @id @default(cuid())
  businessId String
  name       String
  color      String   @default("#00D4FF")
  createdAt  DateTime @default(now())

  business WebStackProBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts WebStackProContact[] @relation("ContactTags")

  @@unique([businessId, name])
  @@index([businessId])
}

// =============================
// WebStackPro CANNED RESPONSES (saved quick replies for human agents)
// =============================
model WebStackProCannedReply {
  id         String   @id @default(cuid())
  businessId String
  title      String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business WebStackProBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}